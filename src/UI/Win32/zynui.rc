#include <windows.h>
#include "resource.h"

IDI_ZYN ICON "../../../zynaddsubfx.ico"

IDD_VALUE DIALOGEX 0, 0, 240, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Type a value"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Value:", IDC_VALUE_LABEL, 8, 8, 224, 10
    EDITTEXT        IDC_VALUE_EDIT, 8, 20, 224, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_VALUE_RANGE, 8, 38, 224, 10
    DEFPUSHBUTTON   "OK", IDOK, 128, 58, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 58, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 280, 90
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audio and MIDI"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Audio output:", -1, 8, 8, 264, 10
    COMBOBOX        IDC_AUDIO_DEVICE, 8, 20, 264, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&MIDI input:", -1, 8, 38, 264, 10
    COMBOBOX        IDC_MIDI_DEVICE, 8, 50, 264, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 168, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 222, 70, 50, 14
END

IDD_BANK DIALOGEX 0, 0, 360, 220
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Instrument banks"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Banks:", -1, 8, 6, 130, 10
    LISTBOX         IDC_BANK_LIST, 8, 18, 130, 170, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT | NOT LBS_SORT
    LTEXT           "&Instruments (Space plays a note):", -1, 146, 6, 206, 10
    LISTBOX         IDC_INSTR_LIST, 146, 18, 206, 170, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT | NOT LBS_SORT
    LTEXT           "Into &part:", -1, 8, 198, 40, 10
    COMBOBOX        IDC_BANK_PART, 50, 196, 60, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "&Load", IDOK, 246, 196, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 302, 196, 50, 14
    LTEXT           "", IDC_BANK_STATUS, 118, 198, 120, 10, NOT WS_VISIBLE
END

IDD_FIND DIALOGEX 0, 0, 340, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find a setting"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Find (part of a name; several words all have to match):", -1, 8, 6, 324, 10
    EDITTEXT        IDC_FIND_EDIT, 8, 18, 324, 14, ES_AUTOHSCROLL
    LTEXT           "&Settings found:", -1, 8, 38, 200, 10
    LISTBOX         IDC_FIND_LIST, 8, 50, 324, 132, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT | NOT LBS_SORT
    LTEXT           "", IDC_FIND_COUNT, 8, 190, 170, 10
    DEFPUSHBUTTON   "&Go to", IDOK, 228, 188, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 282, 188, 50, 14
END
