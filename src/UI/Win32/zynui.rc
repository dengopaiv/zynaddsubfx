#include <windows.h>
#include "resource.h"

IDI_ZYN ICON "../../../zynaddsubfx.ico"

IDD_VALUE DIALOGEX 0, 0, 240, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Type a value"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Value:", IDC_VALUE_LABEL, 8, 8, 224, 10
    EDITTEXT        IDC_VALUE_EDIT, 8, 20, 224, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_VALUE_RANGE, 8, 38, 224, 10
    DEFPUSHBUTTON   "OK", IDOK, 128, 58, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 58, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 280, 90
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audio and MIDI"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Audio output:", -1, 8, 8, 264, 10
    COMBOBOX        IDC_AUDIO_DEVICE, 8, 20, 264, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&MIDI input:", -1, 8, 38, 264, 10
    COMBOBOX        IDC_MIDI_DEVICE, 8, 50, 264, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 168, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 222, 70, 50, 14
END
